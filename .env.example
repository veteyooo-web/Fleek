# Скопируйте файл в .env и подставьте свои значения:  copy .env.example .env  (Linux/macOS) /  Copy-Item .env.example .env  (Windows PowerShell)

# --- Django ---
DJANGO_SECRET_KEY=сгенерируйте-свой-ключ-не-менее-50-символов
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow

# --- База данных ---
# sqlite (для локальной разработки) или postgresql (для docker/продакшена)
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# Раскомментируйте и заполните для PostgreSQL:
# DB_ENGINE=postgresql
# POSTGRES_DB=taskly
# POSTGRES_USER=taskly
# POSTGRES_PASSWORD=taskly
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Почта (опционально) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Taskly <noreply@taskly.local>
